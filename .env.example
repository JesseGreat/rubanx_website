# Copy this file to .env.local for development, and set the same values in the
# Vercel project settings for preview and production.

# Resend API key. Required for the contact form to send anything.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to techzypa@gmail.com if unset.
CONTACT_TO_EMAIL=techzypa@gmail.com

# The address enquiries are sent from. Resend will only send from a domain you
# have verified, so keep the onboarding sender until zypatech.online is
# verified in Resend, then change this.
# TODO: verify zypatech.online in Resend and switch to an address on it.
CONTACT_FROM_EMAIL="Zypa Tech <onboarding@resend.dev>"

# Cal.com or Calendly link for the booking block on the contact page.
# While this is TODO or unset, the contact page shows an asset-needed note
# instead of a dead button.
# TODO: client to supply.
NEXT_PUBLIC_BOOKING_URL=TODO

# Search engine ownership checks. Paste only the token from the verification
# meta tag (the content="..." value), not the whole tag.
# Google Search Console: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=
